{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strictPropertyInitialization": false,
    "baseUrl": ".",
    "paths": {
      "@app": ["apps/frontend/src/app"],
      "@app/*": ["apps/frontend/src/app/*"],
      "@context/*": ["apps/frontend/src/context/*"],
      "@api/*": ["apps/api/src/*"],
      "@frontend-assets/*": ["apps/frontend/assets/*"],
      "@frontend/*": ["apps/frontend/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
