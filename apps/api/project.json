{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "development",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/api",
        "main": "apps/api/src/main.ts",
        "tsConfig": "apps/api/tsconfig.app.json",
        "assets": ["apps/api/src/assets", "apps/api/src/.env"],
        "webpackConfig": "apps/api/webpack.config.js",
        "generatePackageJson": true,
        "sourceMap": true,
        "deleteOutputPath": false
      },
      "configurations": {
        "development": {
          "generatePackageJson": true
        },
        "production": {
          "generatePackageJson": true
        }
      }
    },

    "build-deploy-api-dev": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "firebase use aero-racehub",
            "description": "Sets the Firebase project to aero-racehub"
          },
          {
            "command": "nx run api:build",
            "description": "Builds the api project"
          },
          {
            "command": "cp $(pwd)/apps/api/prisma/schema.prisma $(pwd)/dist/apps/api",
            "description": "Copies the prisma schema to the `dist` folder"
          },
          {
            "command": "firebase deploy --only functions --debug",
            "description": "Deploys the Firebase project"
          }
        ],
        "parallel": false
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    }
  }
}
