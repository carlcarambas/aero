{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend/src",
  "projectType": "application",
  "tags": [],

  "targets": {
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "frontend:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "frontend:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "frontend:build:production",
          "hmr": false
        }
      }
    },
    "build-deploy-ui": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "echo npm version patch",
            "description": "Bumps the version in package.json"
          },
          {
            "command": "firebase use aero-racehub",
            "description": "Sets the Firebase project to use"
          },
          {
            "command": "npm run dist:clean",
            "description": "Cleans the ui project"
          },
          {
            "command": "nx run frontend:build",
            "description": "Builds the ui project"
          },
          {
            "command": "firebase deploy --only hosting",
            "description": "Deploys the Firebase Hosting"
          }
        ],
        "parallel": false
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/frontend"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    }
  },
  "test": {
    "executor": "@nrwl/jest:jest",
    "options": {
      "jestConfig": "apps/client/jest.config.ts",
      "passWithNoTests": true
    }
  }
}
